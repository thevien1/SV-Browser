# ========================================================
# SV BROWSER - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ========================================================

# Môi trường chạy ứng dụng (production / development)
NODE_ENV=production

# Cổng khởi chạy máy chủ REST API Gateway nội bộ (Mặc định: 8725)
API_PORT=8725

# Cho phép truy cập API từ mạng ngoài (true / false)
ALLOW_REMOTE_INTERNET=false

# Khóa bí mật dùng để mã hóa và ký bản quyền License Key (HMAC Salt)
LICENSE_SECRET_SALT=GPM_LOGIN_GLOBAL_SECRET_SALT_2026_SECURE_AUTH_KEY_#99

# Địa chỉ máy chủ kiểm tra cập nhật Cores & phần mềm (Update Server)
UPDATE_SERVER_URL=https://api.svbrowser.com

# Đường dẫn thư mục lưu trữ profile trình duyệt (để trống nếu dùng mặc định ./profiles_data)
# STORAGE_PATH=D:\Phần mềm\GPMLoginGlobal-v1\profiles_data

# URL kết nối Web Quản lý trung tâm (SaaS Cloud Dashboard)
# CLOUD_API_URL=https://cloud.svbrowser.com/api/v1
# CLOUD_API_KEY=
